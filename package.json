{
  "name": "viscue-extension",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "test": "node --test local-server/tests/*.test.mjs gesture/tests/*.test.mjs extension/tests/*.test.mjs",
    "test:gesture": "node --test gesture/tests/*.test.mjs",
    "test:ml": ".venv-gesture\\Scripts\\python.exe -m pytest ml/tests -q",
    "checkpoint": "node scripts/source-manifest.mjs . artifacts/manifests/source-current.json",
    "server": "node local-server/server.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "web:dev": "pnpm --dir web dev",
    "web:test": "pnpm --dir web test",
    "web:build": "pnpm --dir web build"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^1.33.0",
    "onnxruntime-web": "1.29.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2"
  }
}
