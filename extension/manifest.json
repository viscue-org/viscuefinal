{
  "manifest_version": 3,
  "name": "Viscue — Visual intent layer",
  "version": "3.3.0",
  "description": "Build verified multimodal AI instructions from visual references.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8787/*"
  ],
  "action": { "default_title": "Open Viscue", "default_popup": "popup.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://claude.ai/*", "https://copilot.microsoft.com/*", "https://www.perplexity.ai/*", "https://grok.com/*"],
    "js": ["handoff-contract.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"
  }],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "128": "icons/icon-128.png" },
  "web_accessible_resources": [{
    "resources": ["models/*", "*.wasm"],
    "matches": ["<all_urls>"]
  }]
}
